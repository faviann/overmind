FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props ./
COPY src/MemSrv.Core/MemSrv.Core.csproj src/MemSrv.Core/
COPY src/CaptureAdapters/CaptureAdapters.csproj src/CaptureAdapters/
COPY src/CodexCaptureTracer/CodexCaptureTracer.csproj src/CodexCaptureTracer/
RUN dotnet restore src/CodexCaptureTracer/CodexCaptureTracer.csproj
COPY src/MemSrv.Core/ src/MemSrv.Core/
COPY src/CaptureAdapters/ src/CaptureAdapters/
COPY src/CodexCaptureTracer/ src/CodexCaptureTracer/
RUN dotnet publish src/CodexCaptureTracer/CodexCaptureTracer.csproj \
    -c Release -o /out --no-restore

FROM mcr.microsoft.com/dotnet/runtime:10.0
ARG VERSION
WORKDIR /app
COPY --from=build /out/ ./
COPY config/ /app/config/
RUN test -n "$VERSION" && mkdir /state && chown 65532:65532 /state
USER 65532:65532
ENV OVERMIND_CODEX_SESSIONS_ROOT=/capture/sessions \
    OVERMIND_CODEX_ARCHIVE_ROOT=/capture/archived_sessions \
    OVERMIND_CAPTURE_STATE_DIR=/state
LABEL org.opencontainers.image.title="Overmind Codex capture runtime" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.description="Codex-only scanner-first catch-up runtime"
EXPOSE 43191
ENTRYPOINT ["dotnet", "/app/CodexCaptureTracer.dll"]
