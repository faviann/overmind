# Compatibility filename for local callers. Release CI and supported
# documentation use Dockerfile.capture-runtime.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props ./
COPY src/MemSrv.Core/MemSrv.Core.csproj src/MemSrv.Core/
COPY src/CaptureAdapters/CaptureAdapters.csproj src/CaptureAdapters/
COPY src/CodexCaptureTracer/CodexCaptureTracer.csproj src/CodexCaptureTracer/
RUN dotnet restore src/CodexCaptureTracer/CodexCaptureTracer.csproj
COPY src/MemSrv.Core/ src/MemSrv.Core/
COPY src/CaptureAdapters/ src/CaptureAdapters/
COPY src/CodexCaptureTracer/ src/CodexCaptureTracer/
RUN dotnet publish src/CodexCaptureTracer/CodexCaptureTracer.csproj -c Release -o /out --no-restore

FROM mcr.microsoft.com/dotnet/runtime:10.0
WORKDIR /app
COPY --from=build /out/ ./
COPY config/ /app/config/
COPY fixtures/transcripts/ /app/fixtures/transcripts/
RUN mkdir /state && chown 65532:65532 /state
USER 65532:65532
ENV OVERMIND_CODEX_TRANSCRIPT_ROOT=/app/fixtures/transcripts \
    OVERMIND_CAPTURE_STATE_DIR=/state
LABEL org.opencontainers.image.description="Codex-only scanner-first catch-up runtime"
ENTRYPOINT ["dotnet", "/app/CodexCaptureTracer.dll"]
