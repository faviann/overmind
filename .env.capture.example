# Machine-owned immutable artifact and central server facts.
OVERMIND_CAPTURE_IMAGE=ghcr.io/faviann/overmind-codex-capture:<IMMUTABLE_VERSION_OR_DIGEST>
OVERMIND_CAPTURE_URL=http://overmind.example:8080
OVERMIND_CODEX_SESSIONS_ROOT=/home/operator/.codex/sessions
OVERMIND_CODEX_ARCHIVE_ROOT=/home/operator/.codex/archived_sessions
OVERMIND_REPOSITORY_ROOT=/home/operator/repos

# Optional pre-provisioned capture-only credential. Leave unset for browser pairing.
# OVERMIND_CAPTURE_CREDENTIAL=mcap_<REPLACE_WITH_CAPTURE_CREDENTIAL>

# Machine-owned catch-up cadence. Policy and routing remain server-owned.
OVERMIND_CAPTURE_SCAN_INTERVAL_MS=1000
OVERMIND_CAPTURE_SCAN_JITTER_MS=250
